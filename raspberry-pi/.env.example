# Kopieren nach .env (wird nicht committed) und anpassen.

# Port der Web-GUI auf dem Pi
WEB_PORT=8080

# Optionaler Zugriffsschutz für die Web-GUI im WLAN. Leer = offen für alle im Netz.
# Mit Token: einmal http://<pi>:8080/?token=<TOKEN> öffnen (setzt ein Cookie).
WEB_TOKEN=

# rclone-Ziel für Backups (Name des Remotes aus `rclone config` : Ordner)
BACKUP_REMOTE=gdrive:nextbike-backups
# Backups auf dem Remote so viele Tage behalten (jedes Backup ist eine Vollkopie, ≈ 0.4 MB pro gesammeltem Tag)
BACKUP_KEEP_DAYS=14
# Wie oft nach neuen Backups geschaut wird (Sekunden)
BACKUP_UPLOAD_INTERVAL=3600

# Kopieren nach .env (wird nicht committed) und anpassen.

# Port der Statusseite
WEB_PORT=8080
# Optionaler Zugriffsschutz für die Statusseite. Leer = offen im WLAN.
WEB_TOKEN=

# Optional: E-Mail für den GBFS-2.3-Endpunkt von sharedmobility.ch (wird als Authorization-Header gesendet).
# Leer = offener GBFS-2.0-Endpunkt (gleiche Fahrzeugdaten).
GBFS_AUTH_EMAIL=

# rclone-Ziel (Remote-Name aus `rclone config` : Ordner)
BACKUP_REMOTE=gdrive:sharedmob
BACKUP_UPLOAD_INTERVAL=3600
# Welche Ordner aus data/ hochgeladen werden ("backups" ergänzen für DB-Kopien)
BACKUP_DIRS=archive raw
